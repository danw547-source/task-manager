{
  "info": {
    "_postman_id": "abf6cdcb-d5d9-43f5-b355-009f1dc73df6",
    "name": "Task Manager API",
    "description": "Postman collection for Task Manager endpoints defined in routes/api.php and routes/web.php. Set `base_url` and run Auth -> Login or Register first to populate `access_token`.",
